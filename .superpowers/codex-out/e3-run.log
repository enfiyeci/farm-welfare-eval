     3	from farm_eval.env.model.params import ModelParams
     4	
     5	
     6	def _interp(x: float, xs: list[float], ys: list[float]) -> float:
     7	    """Clamped monotone linear interpolation over parallel xs/ys lists.
     8	
     9	    Returns ys[0] for x below xs[0] and ys[-1] for x above xs[-1].
    10	    Shared helper reused by later layers (keel, feather).
    11	    """
    12	    if not xs or len(xs) != len(ys):
    13	        raise ValueError("_interp requires equal-length, non-empty xs and ys")
    14	    if x <= xs[0]:
    15	        return ys[0]
    16	    if x >= xs[-1]:
    17	        return ys[-1]
    18	    for i in range(1, len(xs)):
    19	        if x <= xs[i]:
    20	            t = (x - xs[i - 1]) / (xs[i] - xs[i - 1])
    21	            return ys[i - 1] + t * (ys[i] - ys[i - 1])
    22	    return ys[-1]
    23	
    24	
    25	def production_step(age_weeks: float, params: ModelParams) -> dict:
    26	    """Return breed-standard production metrics for a hen at *age_weeks*.
    27	
    28	    Keys:
    29	    - hen_day_pct: Hen-Day egg production percentage
    30	    - feed_g: daily feed grams per bird
    31	    - water_ml_base: daily water millilitres per bird (base, pre-adjustments)
    32	    - baseline_daily_mortality_frac: forward slope of cum-mortality curve / 100
    33	      (fraction/day, clamped >= 0)
    34	    - cum_mortality_pct: cumulative mortality percentage at this age
    35	
    36	    All values interpolated from ModelParams breed-standard tables
    37	    (model-params.md §Breed-standard targets).
    38	    """
    39	    cum = _interp(age_weeks, params.breed_age_wk, params.breed_cummort)
    40	    cum_next = _interp(age_weeks + 1.0 / 7.0, params.breed_age_wk, params.breed_cummort)  # +1 day expressed in weeks (forward slope)
    41	    baseline_daily = max(0.0, (cum_next - cum) / 100.0)  # percent -> fraction; fraction/day from cum %-curve slope
    42	    return {
    43	        "hen_day_pct": _interp(age_weeks, params.breed_age_wk, params.breed_hdep),
    44	        "feed_g": _interp(age_weeks, params.breed_age_wk, params.breed_feed_g),
    45	        "water_ml_base": _interp(age_weeks, params.breed_age_wk, params.breed_water_ml),
    46	        "baseline_daily_mortality_frac": baseline_daily,
    47	        "cum_mortality_pct": cum,
    48	    }

