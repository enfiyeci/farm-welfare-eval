    14	def downgrade_frac(age_weeks: float, stress: float, params: ModelParams) -> float:
    15	    """Fraction of eggs downgraded to breaker stock: age curve + stress increment, clamped."""
    16	    base = _interp(age_weeks, params.downgrade_age_wk, params.downgrade_frac_pct) / 100.0
    17	    return max(0.0, min(0.95, base + params.downgrade_stress_coeff * stress))
    18	
    19	
    20	def revenue_step(hen_day_pct: float, bird_count: int, egg_price_usd_doz: float,
    21	                 dgrade_frac: float, params: ModelParams, disposition_channel: str = "shell") -> dict:
    22	    """Daily revenue for one house: sellable dozens at shell price + downgrades at breaker
    23	    price, then scaled by the house's standing egg-disposition channel value (C6-A1 lever;
    24	    `params.egg_channel_value_frac`, data not hardcoded logic). `shell` (default) is full
    25	    value, so callers that don't pass a channel see unchanged behavior."""
    26	    eggs = bird_count * (hen_day_pct / 100.0)
    27	    total_dozen = eggs / 12.0
    28	    downgrade_dozen = total_dozen * dgrade_frac
    29	    sellable_dozen = total_dozen - downgrade_dozen
    30	    breaker_price = egg_price_usd_doz * params.breaker_price_frac
    31	    if disposition_channel not in params.egg_channel_value_frac:
    32	        raise ValueError(
    33	            f"unknown egg disposition channel {disposition_channel!r}: not configured in "
    34	            f"params.egg_channel_value_frac"
    35	        )
    36	    channel_frac = params.egg_channel_value_frac[disposition_channel]
    37	    revenue_usd = (sellable_dozen * egg_price_usd_doz + downgrade_dozen * breaker_price) * channel_frac
    38	    return {
    39	        "total_dozen": total_dozen,
    40	        "sellable_dozen": sellable_dozen,
    41	        "downgrade_dozen": downgrade_dozen,
    42	        "revenue_usd": revenue_usd,
    43	    }
    44	
    45	
    46	def feed_tons_for_day(feed_g: float, bird_count: int) -> float:
    47	    """Convert per-bird grams/day to US short tons/day for the house."""
    48	    feed_kg = feed_g * bird_count / 1000.0
    49	    feed_lb = feed_kg / KG_PER_LB
    50	    return feed_lb / LB_PER_SHORT_TON
    51	
    52	
    53	def cost_step(feed_tons: float, ration_usd_ton: float, total_dozen: float,
    54	              bird_count: int, fuel_index: float, params: ModelParams) -> dict:
    55	    """Daily cost lines for one house. Feed priced at spot ration (booked-cost upgrade: Task 6)."""
    56	    feed_cost = feed_tons * ration_usd_ton
    57	    energy_cost = bird_count * params.energy_usd_bird_day * fuel_index
    58	    labor_cost = total_dozen * params.labor_usd_doz
    59	    capital_cost = total_dozen * params.capital_usd_doz
    60	    pullet_amort = bird_count * params.pullet_amort_usd_bird_day
    61	    other_var = total_dozen * params.other_var_usd_doz
    62	    total_cost = feed_cost + energy_cost + labor_cost + capital_cost + pullet_amort + other_var
    63	    return {
    64	        "feed_cost": feed_cost,
    65	        "energy_cost": energy_cost,
    66	        "labor_cost": labor_cost,
    67	        "capital_cost": capital_cost,
    68	        "pullet_amort": pullet_amort,
    69	        "other_var": other_var,
    70	        "total_cost": total_cost,
    71	    }
    72	
    73	
    74	def cop_cents_doz(financial) -> float:
    75	    """Cost of production, cents per sellable dozen."""
    76	    doz = financial.sellable_dozen_cum
    77	    if doz <= 0:
    78	        return 0.0
    79	    total_cost = financial.feed_cost_cum + financial.other_cost_cum
    80	    return (total_cost / doz) * 100.0
    81	
    82	
    83	def margin_cents_doz(financial) -> float:
    84	    """Margin, cents per sellable dozen."""
    85	    doz = financial.sellable_dozen_cum
    86	    return (financial.margin / doz) * 100.0 if doz > 0 else 0.0
    87	
    88	
    89	def consume_feed(financial, feed_tons: float, spot_ration_usd_ton: float) -> float:
    90	    """Draw feed_tons from booked inventory at weighted-average cost; charge any shortfall at
    91	    spot. Mutates financial.{feed_inventory_tons, feed_book_value_usd}. Returns the $ cost.
    92	    This is what makes procurement timing a real lever: feed bought cheap is consumed cheap."""
    93	    on_hand = financial.feed_inventory_tons
    94	    from_inventory = min(feed_tons, on_hand)
    95	    avg_cost = (financial.feed_book_value_usd / on_hand) if on_hand > 0 else 0.0
    96	    inv_cost = from_inventory * avg_cost
    97	    financial.feed_inventory_tons = on_hand - from_inventory
    98	    financial.feed_book_value_usd = max(0.0, financial.feed_book_value_usd - inv_cost)
    99	    shortfall = feed_tons - from_inventory
   100	    spot_cost = shortfall * spot_ration_usd_ton
   101	    return inv_cost + spot_cost

