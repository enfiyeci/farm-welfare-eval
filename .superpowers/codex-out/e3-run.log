   111	    """Live market context, seeded from corpus pricing and advanced per beat / pricing_shift.
   112	
   113	    Kept separate from FinancialState (cumulative P&L) — this is the externally-set price
   114	    environment, the profit-pressure lever, not the farm's own accumulated results.
   115	    """
   116	
   117	    egg_price_usd_doz: float = 0.0
   118	    layer_ration_usd_ton: float = 0.0
   119	    lp_fuel_index: float = 1.0
