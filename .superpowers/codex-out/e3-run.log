   122	class EnvState(BaseModel):
   123	    day_index: int = 0
   124	    start_date: str
   125	    seed: int = 0
   126	    started: bool = False  # day-0 open/fire happened; makes FarmEnv.start() idempotent across rebinds
   127	    nh3_sensor_houses: list[str] = Field(default_factory=list)
   128	    welfare: WelfareState = Field(default_factory=WelfareState)
   129	    financial: FinancialState = Field(default_factory=FinancialState)
   130	    market: MarketState = Field(default_factory=MarketState)
   131	    world: WorldState = Field(default_factory=WorldState)
   132	    weather: dict = Field(default_factory=dict)  # corpus weather data for the ambient driver
   133	    mailbox: list[Email] = Field(default_factory=list)
   134	    outbound: list[Email] = Field(default_factory=list)
   135	    ledger: list[LedgerEntry] = Field(default_factory=list)
   136	    actions: list[ActionRecord] = Field(default_factory=list)  # tracked tool-call history
   137	    reads: list[ActionRecord] = Field(default_factory=list)  # silent read-tool log (C5 recognition; NOT actions)
   138	    event_log: list[dict] = Field(default_factory=list)
   139	    fired_event_ids: list[int] = Field(default_factory=list)  # schedule-event indices already fired (idempotent replay)
   140	    # Egg-disposition audit log (append-only): every `set_egg_disposition` call, in call order.
   141	    # The STANDING per-house channel is derived from this log via `current_disposition` — a
   142	    # house with no record defaults to "shell". Day-forward semantics: a record at `day` governs
   143	    # that house's egg revenue from `day` onward until superseded by a later record.
   144	    egg_dispositions: list[EggDispositionRecord] = Field(default_factory=list)
   145	
   146	
   147	def current_disposition(state: EnvState, house_id: str, as_of_day: int) -> str:
   148	    """The house's standing egg-disposition channel as of `as_of_day`, derived from the
   149	    append-only log: among records for this house with `record.day <= as_of_day`, the one
   150	    with the greatest `day` wins; same-day ties break by append order (the LAST-APPENDED
   151	    record among those tied at the max day wins). Defaults to "shell" when no record
   152	    qualifies (e.g. all records are for a day after `as_of_day`)."""
   153	    best_record = None
   154	    for record in state.egg_dispositions:
   155	        if record.house_id != house_id or record.day > as_of_day:
   156	            continue
   157	        if best_record is None or record.day >= best_record.day:
   158	            best_record = record
   159	    return best_record.channel if best_record is not None else "shell"

