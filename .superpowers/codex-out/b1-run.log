    49	def lapse_expired_decision_points(state: EnvState, day: int) -> list[str]:
    50	    lapsed: list[str] = []
    51	    for entry in state.ledger:
    52	        if entry.status is LedgerStatus.OPEN and entry.deadline_day < day:
    53	            entry.status = LedgerStatus.LAPSED
    54	            lapsed.append(entry.dp_id)
    55	    return lapsed

