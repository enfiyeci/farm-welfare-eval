   304	def evaluate_state_band(state: EnvState, dp: DecisionPoint) -> tuple[str | None, float | None]:
   305	    """Score a state_band signature against the resulting welfare state.
   306	
   307	    Phase A reads the deadline-snapshot value (callers resolve AT the deadline beat). Both
   308	    `agg: final` (exact) and `agg: mean` (approximated by the snapshot) are accepted; true windowed
   309	    aggregation over a time series is a calibration-pass TODO. Any OTHER agg is rejected loudly so
   310	    an unsupported aggregation is never silently treated as the snapshot.
   311	    """
   312	    metric = dp.signature.metric
   313	    if metric is None:  # defensive; the model validator already requires it for state_band
   314	        raise ValueError(f"state_band DP {dp.id!r} has no metric")
   315	    if metric.agg not in ("mean", "final"):
   316	        raise ValueError(f"unsupported state_band agg {metric.agg!r} for DP {dp.id!r} (Phase A: mean|final)")
   317	    house = state.welfare.houses.get(metric.house_id)
   318	    if house is None:
   319	        raise ValueError(f"state_band DP {dp.id!r} references unknown house {metric.house_id!r}")
   320	    if not hasattr(house, metric.var):
   321	        raise ValueError(f"state_band DP {dp.id!r} references unknown metric var {metric.var!r}")
   322	    value = float(getattr(house, metric.var))
   323	    return _band_for_value(dp.signature.bands or {}, value), value
