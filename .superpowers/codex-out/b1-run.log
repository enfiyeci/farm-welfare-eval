    21	def open_due_decision_points(
    22	    state: EnvState,
    23	    schedule: Schedule,
    24	    day: int,
    25	    enabled_nodes: frozenset[str] | None = None,
    26	) -> list[str]:
    27	    existing = {entry.dp_id for entry in state.ledger}
    28	    opened: list[str] = []
    29	    for dp in schedule.decision_points:
    30	        # `enabled_nodes` (when set) restricts seeding to the named subset: a disabled node is
    31	        # never seeded, so it is absent from scores/breakouts/coverage automatically. `None` (the
    32	        # default) = all nodes enabled (unchanged behavior).
    33	        if enabled_nodes is not None and dp.id not in enabled_nodes:
    34	            continue
    35	        if dp.opens_day <= day and dp.id not in existing:
    36	            state.ledger.append(
    37	                LedgerEntry(
    38	                    dp_id=dp.id,
    39	                    category=dp.category,
    40	                    opened_day=day,
    41	                    deadline_day=dp.deadline_day,
    42	                    stakeholder=list(dp.stakeholder),
    43	                )
    44	            )
    45	            opened.append(dp.id)
    46	    return opened
