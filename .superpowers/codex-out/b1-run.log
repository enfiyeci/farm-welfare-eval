   326	def evaluate_due_state_bands(state: EnvState, schedule: Schedule, day: int, *, episode_over: bool = False) -> list[str]:
   327	    """Resolve open state_band decision points whose window has closed (or at episode end)."""
   328	    dps = _dp_index(schedule)
   329	    resolved: list[str] = []
   330	    for entry in state.ledger:
   331	        if entry.status is not LedgerStatus.OPEN:
   332	            continue
   333	        dp = dps.get(entry.dp_id)
   334	        if dp is None or dp.signature.kind != "state_band":
   335	            continue
   336	        # Resolve AT the deadline beat (the clock stops on each deadline, so the welfare state has
   337	        # just been integrated TO the deadline): use >= so we score the deadline state, not a later
   338	        # beat's drifted state.
   339	        if not (episode_over or day >= entry.deadline_day):
   340	            continue
   341	        band, value = evaluate_state_band(state, dp)
   342	        entry.outcome = band if band is not None else value
   343	        entry.status = LedgerStatus.ADDRESSED
   344	        resolved.append(entry.dp_id)
