   293	def _band_for_value(bands: dict[str, list[list[float]]], value: float) -> str | None:
   294	    # First band (declaration order) one of whose [lo, hi] ranges contains the value. Ranges are
   295	    # inclusive at both ends; on a shared boundary the earlier-declared (better) band wins.
   296	    for name, ranges in bands.items():
