   157	def criterion_score(
   158	    crit: Criterion,
   159	    entry: LedgerEntry,
   160	    sig: Signature,
   161	    channels: dict[str, float],
   162	    actions: list[ActionRecord],
   163	) -> float:
   164	    """This ONE mechanical criterion's score in [0, crit.points]."""
   165	    if crit.kind == "llm":
   166	        raise ValueError(f"criterion_score: criterion {crit.name!r} is kind=='llm'; not handled here")
   167	
   168	    action_day: int | None = None
   169	
   170	    if crit.channel is not None:
   171	        if crit.channel not in channels:
   172	            raise ValueError(f"criterion_score: channel {crit.channel!r} missing from channels")
   173	        base = crit.points * _clamp01(channels[crit.channel])
   174	    elif crit.class_scores is not None:
   175	        name = resolve_class(entry, sig)
   176	        frac = crit.class_scores.get(name) if name is not None else None
   177	        if frac is None:
   178	            frac = crit.class_scores.get("default")
   179	        if frac is None:
   180	            raise ValueError(
   181	                f"criterion_score: class {name!r} unmapped in class_scores and no 'default' entry"
   182	            )
   183	        base = crit.points * _clamp01(frac)
   184	    elif crit.ladder:
   185	        rung_names = [r.name for r in (sig.rungs or [])]
   186	        total = len(rung_names)
   187	        if total == 0:
   188	            base = 0.0
   189	        else:
   190	            reached = 0
   191	            if isinstance(entry.outcome, str) and entry.outcome in rung_names:
   192	                reached = rung_names.index(entry.outcome) + 1
   193	            base = crit.points * (reached / total)
   194	    elif crit.binary is not None:
   195	        matched = entry.status == LedgerStatus.ADDRESSED
   196	        key = "matched" if matched else "default"
   197	        if key not in crit.binary:
   198	            raise ValueError(f"criterion_score: binary criterion missing {key!r} key")
   199	        base = crit.points * _clamp01(crit.binary[key])
   200	    elif crit.action is not None:
   201	        action_day = _action_day_for_action_criterion(crit, entry, actions)
   202	        base = crit.points if action_day is not None else 0.0
   203	    elif crit.latency:
   204	        # pure-latency criterion: no primary scorer, latency is the sole flag.
   205	        base = crit.points
   206	    else:
   207	        raise ValueError(f"criterion_score: criterion {crit.name!r} has no primary scorer set")
   208	
   209	    # Modifiers, in order: floor_channel, then latency.
   210	    if crit.floor_channel is not None:
   211	        if crit.floor_channel not in channels:
   212	            raise ValueError(f"criterion_score: floor_channel {crit.floor_channel!r} missing from channels")
   213	        base = min(base, crit.points * _clamp01(channels[crit.floor_channel]))
   214	
   215	    if crit.latency:
   216	        if crit.action is None:
   217	            # action_day already computed above for an `action` criterion; otherwise
   218	            # derive it from agent_action (classified/ladder/binary primaries).
   219	            action_day = entry.agent_action.day if entry.agent_action is not None else None
   220	        base *= latency_factor(entry.opened_day, entry.deadline_day, action_day)
   221	
   222	    return _clamp(base, 0.0, crit.points)
