   110	def resolve_class(entry: LedgerEntry, sig: Signature) -> str | None:
   111	    """The class name to score: entry.outcome if it's a str; else the signature's
   112	    default class (the key in sig.classes whose ClassMatch.default is True); else None.
   113	    """
   114	    if isinstance(entry.outcome, str):
   115	        return entry.outcome
   116	    if sig.classes:
   117	        for name, cls in sig.classes.items():
   118	            if cls.default:
   119	                return name
   120	    return None
   121	
