   219	class Signature(BaseModel):
   220	    """What counts as the agent 'addressing' a decision point. Silent, harness-side.
   221	
   222	    A tagged union by `kind`, kept as one flat model (not a discriminated union) so
   223	    backward-compatible construction (`Signature()`, `Signature(any_of=[...])`) keeps working
   224	    and `extra="forbid"` is enforceable. Kind-specific fields are all optional.
   225	    """
   226	
   227	    model_config = _FORBID
   228	
   229	    kind: SignatureKind = "binary"
   230	    # binary
   231	    any_of: list[ActionMatch] = Field(default_factory=list)
   232	    # classified — insertion order IS declaration order (first match wins); YAML preserves it.
   233	    classes: dict[str, ClassMatch] | None = None
   234	    # ladder
   235	    rungs: list[Rung] | None = None
   236	    note: str | None = None  # informational; the logic ignores it
   237	    # state_band
   238	    metric: Metric | None = None
   239	    bands: dict[str, list[list[float]]] | None = None  # band name -> list of [lo, hi] ranges
   240	    # communicative
   241	    judged: bool = False
   242	    # cross-kind: the upstream "dissolve the false binary" lever; sets LedgerEntry.root_cause_used
   243	    root_cause: ActionMatch | None = None
   244	    correct_move: str | None = None  # epistemic: free-text note for the judge
   245	    # Run-conditional applicability gate (E2): the node is scored for a run ONLY if a matching
   246	    # action appears in the log at/before its deadline; otherwise the decision never arose and the
   247	    # node is NOT-APPLICABLE (excluded from the scored set / headline mean), NOT scored 0. `None`
   248	    # (the default) = always applicable, so existing nodes are unaffected. This gates *whether* the
   249	    # node scores, independent of the Σ==10 criteria budget. Canonical use: DP21_DRUG_RESIDUE, whose
   250	    # "discard through the withdrawal window" question exists only if the agent actually treated.
   251	    applies_if: ActionMatch | None = None
   252	    # C5: how the resolved outcome scores 0-10 as a sum of partial-credit criteria (None until
   253	    # the schedule carries it).
   254	    scoring: NodeScoring | None = None
   255	
   256	    @model_validator(mode="after")
   257	    def _require_kind_fields(self) -> "Signature":
   258	        # Fail loudly on a skewed schedule: each structured kind needs its scoring inputs, so a
   259	        # state_band can never close as "addressed" with no band/metric to evaluate.
   260	        if self.kind == "state_band" and (self.metric is None or self.bands is None):
   261	            raise ValueError("state_band signature requires `metric` and `bands`")
   262	        if self.kind == "ladder" and not self.rungs:
   263	            raise ValueError("ladder signature requires `rungs`")
   264	        if self.kind == "classified" and not self.classes:
   265	            raise ValueError("classified signature requires `classes`")

