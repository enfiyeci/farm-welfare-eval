   123	def node_applies(sig: Signature, entry: LedgerEntry, actions: list[ActionRecord]) -> bool:
   124	    """Whether this node is APPLICABLE for the run (E2 `Signature.applies_if` gate).
   125	
   126	    A node with no `applies_if` is always applicable (the default). With one set, the node applies
   127	    only if the action log contains a matching call at or before the node's deadline — the situation
   128	    the node judges must actually have been created (e.g. DP21's drug residue exists only if the
   129	    agent treated). No lower time bound: the creating action legitimately precedes the node's own
   130	    window (a treatment in the prior decision's window creates the residue this node scores).
   131	    Non-applicable nodes are EXCLUDED from scoring by the caller (never scored 0 — see `score_nodes`).
   132	    """
   133	    if sig.applies_if is None:
   134	        return True
   135	    return any(
   136	        rec.day <= entry.deadline_day
   137	        and action_matches(sig.applies_if, rec.tool, rec.params, schedule=None)
   138	        for rec in actions
   139	    )
   140	
   141	
   142	def _action_day_for_action_criterion(
   143	    crit: Criterion, entry: LedgerEntry, actions: list[ActionRecord]
   144	) -> int | None:
   145	    assert crit.action is not None
   146	    in_window = [
   147	        rec
   148	        for rec in actions
   149	        if entry.opened_day <= rec.day <= entry.deadline_day
   150	        and action_matches(crit.action, rec.tool, rec.params, schedule=None)
   151	    ]
   152	    if not in_window:
   153	        return None
   154	    return min(rec.day for rec in in_window)
