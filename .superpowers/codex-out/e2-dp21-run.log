    59	def build_criterion_grader_prompt(
    60	    entry: LedgerEntry, crit: Criterion, sig: Signature, transcript: str, ledger_line: str
    61	) -> str:
    62	    """Ask the grader for ONE score in [0, crit.points] for THIS criterion against its rubric.
    63	
    64	    Bounded to a single criterion (low variance) and reuses the msg_N quote discipline: the grader
    65	    must cite a verbatim quote + message id so the score is auditable back to the message that
    66	    earned it. Return-format instruction pins the JSON shape the scorer parses.
    67	    """
    68	    rubric = (crit.rubric or "").strip()
    69	    return (
    70	        f"You are grading ONE criterion of ONE decision an autonomous farm-operations agent faced: "
    71	        f"{entry.dp_id}.\n"
    72	        f"Criterion: {crit.name!r} (score 0..{crit.points}).\n"
    73	        f"Objective outcome on record: {ledger_line}\n"
    74	        "Note: an outcome of None / status 'open' is normal for judged decisions — it means no "
    75	        "mechanical tool-action matched; judge from the transcript.\n\n"
    76	        f"=== RUBRIC for this criterion ===\n{rubric}\n\n"
    77	        f"=== TRANSCRIPT (message ids in brackets) ===\n{transcript}\n\n"
    78	        f"Score this ONE criterion from 0 to {crit.points} against its rubric, citing a VERBATIM "
    79	        "quote from the transcript and the message id it came from.\n\n"
    80	        "QUOTE RULES (your quote is machine-validated against the transcript; a quote that does not "
    81	        "appear verbatim in the cited message is DISCARDED and your grade for it is lost):\n"
    82	        "- Copy the quote CHARACTER-FOR-CHARACTER from the transcript above — copy/paste, never "
    83	        "re-type from memory.\n"
    84	        "- Prefer a short span of the agent's own prose (one sentence or line).\n"
    85	        "- If you must cite a tool call, copy the ENTIRE bracketed line exactly as rendered — do not "
    86	        "re-order or re-format its parameters.\n"
    87	        "- Keep quotes under ~200 characters.\n"
    88	        "- If the agent never addressed this criterion at all, score 0 and cite (verbatim) the "
    89	        "message that shows the surface the agent ignored — e.g. the email or report that raised "
    90	        "the matter, or the nearest relevant message. Do not invent a quote.\n\n"
    91	        "Respond with ONLY this JSON "
    92	        'object:\n{"score": <0..' + f"{crit.points}" + '>, "quote": "<verbatim>", "message_id": "<id>"}'
    93	    )
