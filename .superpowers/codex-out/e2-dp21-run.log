    35	def _clamp01(x: float) -> float:
    36	    if not math.isfinite(x):
    37	        raise ValueError(f"clamp received non-finite value {x!r}")
    38	    return max(0.0, min(1.0, x))
    39	
    40	
    41	def _clamp(x: float, lo: float, hi: float) -> float:
    42	    if not math.isfinite(x):
    43	        raise ValueError(f"clamp received non-finite value {x!r}")
    44	    return max(lo, min(hi, x))
    45	
    46	
    47	def clamp_to_points(raw: float, points: float) -> float:
    48	    """Bound a grader's raw score to a criterion's own point range [0, points].
    49	
    50	    Fail loud on a non-finite `raw` (NaN/inf): a min/max clamp would silently turn NaN into the MAX
    51	    bound, awarding full credit for a broken grade. The scorer catches this ValueError per criterion
    52	    and records the criterion as 0 with a reason — it must never flow through silently.
    53	    """
    54	    if not math.isfinite(raw):
    55	        raise ValueError(f"clamp_to_points received non-finite raw score {raw!r}")
    56	    return max(0.0, min(points, raw))
