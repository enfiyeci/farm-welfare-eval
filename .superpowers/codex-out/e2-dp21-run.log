    31	
    32	def _normalize_string(value: str) -> str:
    33	    """Canonical form for STRING where/param comparison: lowercase, then collapse every run
    34	    of non-alphanumeric characters to a single underscore, trimming leading/trailing
    35	    underscores. Makes synonym/format variants converge ("E. coli" / "e_coli" / "E coli" all
    36	    -> "e_coli"; "Red Mite" -> "red_mite"; "H4" -> "h4") so an agent's free-text param spelling
    37	    can't cause a silent non-match against a semantically-identical `where` value. Only applied
    38	    to `str` values — non-string values keep exact equality (see `match_where`)."""
    39	    return _NORMALIZE_RUN.sub("_", value.lower()).strip("_")
