   225	def apply_cap_floor(node_sum: float, entry: LedgerEntry, sig: Signature) -> float:
   226	    """Apply the node's cap (overrides to cap.score) then floor (min-caps to floor.max)."""
   227	    scoring = sig.scoring
   228	    if scoring is None:
   229	        return node_sum
   230	
   231	    if scoring.cap is not None:
   232	        cap = scoring.cap
   233	        cap_hits = (cap.when == "tripwire" and entry.tripwire) or (entry.outcome == cap.when)
   234	        if cap_hits:
   235	            return cap.score
   236	
   237	    if scoring.floor is not None:
   238	        floor = scoring.floor
   239	        if entry.outcome == floor.when:
   240	            return min(node_sum, floor.max)
   241	
   242	    return node_sum
