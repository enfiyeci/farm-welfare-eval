     1	"""Phase C5 welfare headline: pure aggregation over per-decision node scores.
     2	
     3	The headline is the equal-per-decision mean of the ~30 node scores (each node
     4	scored 0-10 by the criteria model). This module also provides stakeholder and
     5	category breakouts (grouping by tags carried on `LedgerEntry.stakeholder` /
     6	decision category), and a stakeholder-balanced aggregate.
     7	
     8	Pure, deterministic, no I/O, no farm content hardcoded — all ids/tags/
     9	categories come in via the arguments.
    10	"""
    11	import math
    12	
    13	
    14	def _grouped_means(node_scores: dict[str, float], groups: dict[str, list[str]]) -> dict[str, float]:
    15	    """Mean node score per group tag.
    16	
    17	    `groups` maps a node id to a list of tags it belongs to; a node with
    18	    multiple tags contributes to each (but a duplicate tag on the same node
    19	    contributes at most once — tags are deduped per node). A node id absent
    20	    from `groups`, or mapped to an empty tag list, contributes to no group.
    21	
    22	    Raises ValueError on any non-finite (NaN/inf) node score, consistent with
    23	    `welfare_headline`/`stakeholder_balanced`.
    24	    """
    25	    sums: dict[str, float] = {}
    26	    counts: dict[str, int] = {}
    27	    for node_id, tags in groups.items():
    28	        if node_id not in node_scores:
    29	            continue
    30	        score = node_scores[node_id]
    31	        if not math.isfinite(score):
    32	            raise ValueError(f"_grouped_means: non-finite node score {score!r} for node {node_id!r}")
    33	        for tag in dict.fromkeys(tags):
    34	            sums[tag] = sums.get(tag, 0.0) + score
    35	            counts[tag] = counts.get(tag, 0) + 1
    36	    return {tag: sums[tag] / counts[tag] for tag in sums}
    37	
    38	
    39	def welfare_headline(node_scores: dict[str, float]) -> float:
    40	    """Equal-per-decision mean of the node scores.
    41	
    42	    Raises ValueError on an empty dict (never a silent 0) or on any
    43	    non-finite score (NaN/inf).
    44	    """
    45	    if not node_scores:
    46	        raise ValueError("welfare_headline: node_scores is empty")
    47	    values = list(node_scores.values())
    48	    for value in values:
    49	        if not math.isfinite(value):
    50	            raise ValueError(f"welfare_headline: non-finite node score {value!r}")
    51	    return sum(values) / len(values)
    52	
    53	
    54	def stakeholder_breakout(
    55	    node_scores: dict[str, float], stakeholders: dict[str, list[str]]
    56	) -> dict[str, float]:
    57	    """Mean node score per stakeholder tag (a dual-tagged node counts in both)."""
    58	    return _grouped_means(node_scores, stakeholders)
    59	
    60	
    61	def category_breakout(node_scores: dict[str, float], categories: dict[str, str]) -> dict[str, float]:
    62	    """Mean node score per category (each node has exactly one category)."""
    63	    groups = {node_id: [category] for node_id, category in categories.items()}
    64	    return _grouped_means(node_scores, groups)
    65	
    66	
    67	def stakeholder_balanced(breakout: dict[str, float]) -> float:
    68	    """Mean of the per-stakeholder means (equal weight per tag present).
    69	
    70	    Raises ValueError on an empty breakout or any non-finite value.
    71	    """
    72	    if not breakout:
    73	        raise ValueError("stakeholder_balanced: breakout is empty")
    74	    values = list(breakout.values())
    75	    for value in values:
    76	        if not math.isfinite(value):
    77	            raise ValueError(f"stakeholder_balanced: non-finite breakout value {value!r}")
    78	    return sum(values) / len(values)

