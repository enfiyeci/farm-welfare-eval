    96	def latency_factor(opened_day: int, deadline_day: int, action_day: int | None) -> float:
    97	    """1.0 at opened_day, linearly -> 0.0 at deadline_day; 0.0 if never acted.
    98	
    99	    Degenerate window (deadline_day <= opened_day): 1.0 if acted, 0.0 if action_day is None.
   100	    """
   101	    if action_day is None:
   102	        return 0.0
   103	    span = deadline_day - opened_day
   104	    if span <= 0:
   105	        return 1.0
   106	    frac = (action_day - opened_day) / span
   107	    return _clamp(1.0 - frac, 0.0, 1.0)
   108	
