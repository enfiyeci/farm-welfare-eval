+    ]
+    assert criterion_score(crit, entry, sig, {}, actions) == pytest.approx(7.0)
+
+
+def test_dp21_discard_action_wrong_channel_scores_zero():
+    crit, sig, dp = _criterion("DP21_DRUG_RESIDUE", "discard_action")
+    entry = _entry(dp)
+    actions = [
+        ActionRecord(
+            tool="set_egg_disposition",
