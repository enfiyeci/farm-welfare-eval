# Vertex AI config for the pilot. Copy this to scripts/pilot-vertex.env (git-ignored) and fill in
# your project. Vertex uses Application Default Credentials (ADC), NOT an API key:
#   gcloud auth application-default login   # one-time browser step
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-vertex-project-id
GOOGLE_CLOUD_LOCATION=global
