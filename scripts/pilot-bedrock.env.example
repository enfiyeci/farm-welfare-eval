# AWS Bedrock pilot config — copy to scripts/pilot-bedrock.env (git-ignored) and fill in.
#
# The Bedrock long-term API key (Bearer token, prefix ABSKTW...). Inspect's bedrock provider
# reads AWS_BEARER_TOKEN_BEDROCK; the raw curl preflight uses the same value.
# NEVER commit the filled-in file.
AWS_BEARER_TOKEN_BEDROCK=REPLACE_ME

# Region the key was issued for.
AWS_REGION=us-east-1
